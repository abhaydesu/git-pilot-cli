{
  "name": "@abhaydesu/git-pilot",
  "version": "2.0.0",
  "description": "AI-powered Git assistant: commit messages, natural-language git commands, undo suggestions and branch names.",
  "main": "src/cli.js",
  "scripts": {
    "test": "node scripts/run-tests.js",
    "test:e2e": "bash test/e2e/run.sh",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "bin": {
    "git-pilot": "bin/git-pilot.js"
  },
  "type": "module",
  "keywords": [
    "git",
    "cli",
    "ai",
    "gemini",
    "commit",
    "conventional-commits"
  ],
  "author": "",
  "license": "MIT",
  "preferGlobal": true,
  "dependencies": {
    "axios": "^1.20.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.1",
    "execa": "^9.6.0",
    "inquirer": "^12.11.1",
    "ora": "^9.4.1",
    "shell-quote": "^1.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  },
  "files": [
    "bin",
    "src",
    "public",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhaydesu/git-pilot-cli.git"
  }
